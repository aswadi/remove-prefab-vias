{
  "name": "remove-prefab-vias",
  "version": "0.1.0",
  "description": "Remove unused clad holes and pre-existing clad traces from composed Circuit JSON",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "remove-prefab-vias": "./src/cli.ts"
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test"
  },
  "keywords": [
    "tscircuit",
    "circuit-json",
    "pcb",
    "prefab"
  ],
  "dependencies": {
    "circuit-json": "^0.0.450",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "typescript": "^5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
